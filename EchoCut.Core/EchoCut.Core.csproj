<Project Sdk="Microsoft.NET.Sdk">

	<!--
    El motor de EchoCut. Deliberadamente sin sufijo -windows: es el compilador quien impide
    que se cuele aquí una referencia a WinForms, System.Drawing o System.Media. Todo lo que
    dependa del escritorio vive en el proyecto de interfaz.
  -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TagLibSharp" Version="2.3.0" />
	</ItemGroup>

</Project>
